# ==============================================================================
# LINKME Platform - Environment Variable Template
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit real secrets or production credentials to source control.
# - Copy this file to .env for local development.
# - All sensitive keys must be rotated regularly and encrypted at rest.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://linkme_user:linkme_secret_pass@localhost:5432/linkme_db?schema=public

# In-Memory Cache & Queue (Valkey / Redis Wire Compatible)
VALKEY_URL=redis://localhost:6379

# Object Storage (S3 / Cloudflare R2 Compatible)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=placeholder_r2_access_key
S3_SECRET_ACCESS_KEY=placeholder_r2_secret_key
S3_BUCKET_NAME=linkme-assets-dev
S3_FORCE_PATH_STYLE=true

# Application Security & Cryptography
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=temporary_dev_jwt_secret_change_in_production_min_32_chars
SESSION_SECRET=temporary_dev_session_secret_min_32_chars

# Legal & Compliance Policies
MIN_SIGNUP_AGE=18
AGE_POLICY_VERSION=v1.0
TERMS_POLICY_VERSION=v1.0
PRIVACY_POLICY_VERSION=v1.0

# Feature Flags (MVP Zero-Cost Constraints)
FEATURE_AI_PIPELINE_MODE=disabled
FEATURE_BILLING_ENABLED=false
FEATURE_RATE_LIMIT_STRICT=true

# Email Service (Verification & Passwords)
EMAIL_FROM=noreply@linkme.cv
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Worker Concurrency Limits
WORKER_CONCURRENCY_PDF=1
WORKER_CONCURRENCY_SCAN=2
